# Copy this file to .env and fill in real values. .env is git-ignored.
# Groq key (free): https://console.groq.com/keys  -> enables live LLM replies.
# Leave blank and the API still works via graceful template fallback.
GROQ_API_KEY=

# Optional: only needed if you later switch the LLM back to a HF-hosted model.
HF_TOKEN=

# Optional: override the SQLite default for a real Postgres instance.
# DATABASE_URL=postgresql://user:pass@localhost:5432/supportiq